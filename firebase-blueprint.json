{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and personalization settings",
      "type": "object",
      "properties": {
        "personalization": {
          "type": "object",
          "description": "User's persona and custom instruction settings"
        },
        "themeId": {
          "type": "string",
          "description": "ID of the currently active theme",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "number",
          "description": "Last time the user profile was updated"
        }
      },
      "required": ["updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "User conversational chat sessions",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner of the chat session",
          "maxLength": 128
        },
        "modelId": {
          "type": "string",
          "description": "Model alias used in session",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Title of the chat",
          "maxLength": 256
        },
        "messages": {
          "type": "array",
          "description": "List of conversation turns"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last interaction timestamp"
        },
        "isIncognito": {
          "type": "boolean",
          "description": "Incognito chat indicator"
        },
        "folderId": {
          "type": "string",
          "description": "Optional containing folder ID",
          "maxLength": 64
        },
        "expiresAt": {
          "type": "number",
          "description": "Optional expiry timestamp"
        }
      },
      "required": ["userId", "title", "updatedAt"]
    },
    "ChatFolder": {
      "title": "ChatFolder",
      "description": "Folders for organizing chat sessions",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner of the folder",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Folder display name",
          "maxLength": 128
        },
        "color": {
          "type": "string",
          "description": "Folder hex color",
          "maxLength": 32
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        }
      },
      "required": ["userId", "name", "createdAt"]
    },
    "VirtualModel": {
      "title": "VirtualModel",
      "description": "Custom agent persona configurations",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner of the model",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Model display name",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "Model purpose summary",
          "maxLength": 512
        },
        "baseModel": {
          "type": "string",
          "description": "Underlying Gemini model alias",
          "maxLength": 64
        },
        "systemInstruction": {
          "type": "string",
          "description": "Core system prompt",
          "maxLength": 10000
        },
        "knowledgeBase": {
          "type": "string",
          "description": "Additional context text",
          "maxLength": 50000
        }
      },
      "required": ["userId", "name", "baseModel"]
    },
    "ImageCreation": {
      "title": "ImageCreation",
      "description": "AI creations from styles, imagine scenes, remove objects, extend, and perspective shots",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "prompt": {
          "type": "string",
          "description": "Generation prompt or edit description",
          "maxLength": 2048
        },
        "url": {
          "type": "string",
          "description": "Image payload data URL or storage pointer",
          "maxLength": 2000000
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Optimized thumbnail preview",
          "maxLength": 200000
        },
        "editType": {
          "type": "string",
          "description": "Operation type",
          "enum": ["initial", "remove_object", "move_object", "perspective_shift", "extend_image", "imagine_scene"],
          "maxLength": 64
        },
        "toolUsed": {
          "type": "string",
          "description": "Specific creative tool identifier",
          "maxLength": 64
        },
        "styleName": {
          "type": "string",
          "description": "Applied visual style",
          "maxLength": 64
        },
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio of creation",
          "maxLength": 16
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        }
      },
      "required": ["userId", "prompt", "url", "createdAt"]
    },
    "UserStatistics": {
      "title": "UserStatistics",
      "description": "Aggregated user usage statistics and telemetry",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID",
          "maxLength": 128
        },
        "timeSpentSeconds": {
          "type": "number",
          "description": "Total seconds spent"
        },
        "totalMessagesUser": {
          "type": "number",
          "description": "Messages sent by user"
        },
        "totalMessagesModel": {
          "type": "number",
          "description": "Messages sent by AI"
        },
        "totalPromptTokens": {
          "type": "number",
          "description": "Input prompt tokens"
        },
        "totalResponseTokens": {
          "type": "number",
          "description": "Output response tokens"
        },
        "totalImagesCreated": {
          "type": "number",
          "description": "Count of created images"
        },
        "lastActiveDate": {
          "type": "string",
          "description": "ISO date string of last activity",
          "maxLength": 64
        }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User personal preferences and profile settings"
    },
    "/chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Conversational chat histories"
    },
    "/chatFolders/{folderId}": {
      "schema": "ChatFolder",
      "description": "Organizational chat folders"
    },
    "/virtualModels/{modelId}": {
      "schema": "VirtualModel",
      "description": "User-defined AI agents"
    },
    "/imageCreations/{creationId}": {
      "schema": "ImageCreation",
      "description": "Generated and edited visual creations"
    },
    "/userStatistics/{userId}": {
      "schema": "UserStatistics",
      "description": "User app activity and statistics"
    }
  }
}
